{
  "name": "drobek-bot",
  "private": true,
  "version": "0.0.0",
  "description": "Open-source, self-hosted AI teammates. Your own Grok Bot, on your own machine.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint && prettier --check .",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm -r --if-present test:integration",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "db:generate": "pnpm --filter @drobek-bot/db generate",
    "db:migrate": "pnpm --filter @drobek-bot/db... build && pnpm --filter @drobek-bot/db migrate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  }
}
