# Host ports the stack publishes. Change them if they collide with something local.
WEB_PUBLISH=3050
POSTGRES_PUBLISH=5450
REDIS_PUBLISH=6390

# Postgres credentials (dev defaults). Compose builds DATABASE_URL from them.
POSTGRES_USER=drobek
POSTGRES_PASSWORD=drobek
POSTGRES_DB=drobek_bot

# Commit reported by /api/health. `task dev` replaces it with the real one.
GIT_SHA=dev

# Master key of the secret store: 32 random bytes as base64, generated with
#   openssl rand -base64 32
# It only ever lives in this file; the api and the worker read it, a box never does.
# Leave it empty until you store the first secret. See docs/secrets.md.
DROBEK_MASTER_KEY=

# Host-side database URL for `pnpm db:migrate` against the running compose stack.
# The services build their own from the values above; this one is only read by the CLI.
# DATABASE_URL=postgresql://drobek:drobek@localhost:5450/drobek_bot
